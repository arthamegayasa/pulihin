{
  "name": "pulihin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PULIHIN - pendamping rehabilitasi stroke di rumah (prototype lomba .id Developer Day Indonesia 2026)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/fetch-mediapipe-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-mediapipe-assets.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:models": "node scripts/fetch-mediapipe-assets.mjs",
    "suara": "node scripts/suara/buat-suara.mjs --qa"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "@phosphor-icons/react": "2.1.10",
    "idb": "8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
